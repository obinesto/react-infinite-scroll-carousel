{
  "name": "@obinesto/react-infinite-scroll-carousel",
  "version": "1.0.7",
  "description": "A React infinite scroll carousel component with automatic scrolling and navigation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinesto/react-infinite-scroll-carousel.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.cjs",
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "jest",
    "test:release": "node --test .github/scripts/npm/npm-release.test.cjs",
    "test:package": "node scripts/check-package.cjs"
  },
  "keywords": [
    "react",
    "carousel",
    "infinite-scroll",
    "slider",
    "typescript"
  ],
  "author": "Cyprian Obi",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup": "^4.46.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-jest": "^29.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  }
}
